---
/** FoxDesk, HexaFox's own product: an AI assistant that answers from a client's website. */
import BaseLayout from '@layouts/BaseLayout.astro';
import FoxdeskHero from '@components/sections/foxdesk/FoxdeskHero.astro';
import HowItWorks from '@components/sections/foxdesk/HowItWorks.astro';
import Features from '@components/sections/foxdesk/Features.astro';
import Customise from '@components/sections/foxdesk/Customise.astro';
import Audiences from '@components/sections/foxdesk/Audiences.astro';
import Pricing from '@components/sections/foxdesk/Pricing.astro';
import Faq from '@components/sections/foxdesk/Faq.astro';
import FoxdeskCta from '@components/sections/foxdesk/FoxdeskCta.astro';
import { foxdeskApp } from '@lib/schema';
import { homeUrl } from '@lib/url';

const description =
  "FoxDesk is an AI assistant for your website that answers visitors' questions from your own pages, with sources. Built and run by HexaFox Technologies.";
---

<BaseLayout
  title="FoxDesk: AI chatbot for your website"
  {description}
  schema={[foxdeskApp(homeUrl(Astro.site), description)]}
>
  <FoxdeskHero />
  <HowItWorks />
  <Features />
  <Customise />
  <Audiences />
  <Pricing />
  <Faq />
  <FoxdeskCta />
</BaseLayout>
