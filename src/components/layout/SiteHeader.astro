---
import Logo from '@components/ui/Logo.astro';
import Button from '@components/ui/Button.astro';
import MobileMenu from './MobileMenu.astro';
import { navLinks, contactLink } from '@data/navigation';
import { withBase } from '@lib/url';
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo />

    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={withBase(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={withBase(contactLink.href)} size="sm">{contactLink.label}</Button>
      <MobileMenu />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgb(42 35 64 / 0.7);
    background: rgb(14 11 26 / 0.72);
    backdrop-filter: blur(14px) saturate(140%);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: var(--header-h);
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-6);
  }

  .site-nav a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) ease;
  }

  .site-nav a:hover {
    color: var(--color-text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Tighter spacing on tablets, so every link stays on one line next to the logo and button. */
  @media (max-width: 960px) {
    .site-nav ul {
      gap: var(--space-4);
    }
  }

  @media (max-width: 760px) {
    .site-nav {
      display: none;
    }
  }
</style>
