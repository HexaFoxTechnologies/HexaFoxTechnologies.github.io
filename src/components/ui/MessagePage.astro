---
/** Centred one-message layout shared by the 404 and thank-you pages. */
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import ArtFrame from './ArtFrame.astro';
import { withBase } from '@lib/url';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  image?: ImageMetadata;
}

const { eyebrow, title, text, image } = Astro.props;
---

<section class="section message-page">
  <div class="container message-page__inner">
    <div class="message-page__art">
      <ArtFrame image={image} alt="" ratio="1 / 1" sizes="280px" highlight={[1, 3, 5]} />
    </div>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="message-page__text">{text}</p>
    <Button href={withBase()}>Back to home</Button>
  </div>
</section>

<style>
  .message-page__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    max-width: 36rem;
    text-align: center;
  }

  .message-page__art {
    width: min(280px, 70vw);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .message-page__text {
    margin-bottom: var(--space-3);
    color: var(--color-text-muted);
  }
</style>
