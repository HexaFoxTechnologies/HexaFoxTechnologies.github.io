---
import { Image } from 'astro:assets';
import mark from '@assets/brand/logo-mark.png';
import { withBase } from '@lib/url';

interface Props {
  /** Height of the mark in px. */
  size?: number;
}

const { size = 34 } = Astro.props;
---

<a class="logo" href={withBase()} aria-label="HexaFox Technologies, home">
  <Image src={mark} alt="" width={size} densities={[1, 2]} loading="eager" class="logo__mark" />
  <span class="logo__word" aria-hidden="true">Hexa<span>Fox</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .logo__word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .logo__word span {
    color: var(--color-violet-soft);
  }
</style>
