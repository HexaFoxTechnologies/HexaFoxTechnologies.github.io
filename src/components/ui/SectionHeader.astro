---
/** Eyebrow, title and optional intro shown at the top of each section. */
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
  align?: 'start' | 'center';
  /** 1 when this section is the page's main heading (e.g. the story page); 2 otherwise. */
  level?: 1 | 2;
}

const { id, eyebrow, title, intro, align = 'start', level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<header class:list={['section-header', `section-header--${align}`]} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <Heading id={id} class="section-header__title">{title}</Heading>
  {intro && <p class="section-header__intro">{intro}</p>}
  <slot />
</header>

<style>
  .section-header {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .section-header--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .section-header__title {
    font-size: var(--text-2xl);
  }

  .section-header__intro {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>
