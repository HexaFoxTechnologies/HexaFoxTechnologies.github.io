---
/** Framed artwork: shows the image if given, otherwise the hexagon stand-in. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import HexCluster from './HexCluster.astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  ratio?: '4 / 3' | '16 / 9' | '1 / 1' | '3 / 4';
  sizes?: string;
  /** CSS object-position, to keep faces in frame when the image is cropped. */
  focus?: string;
  highlight?: number[];
}

const {
  image,
  alt,
  ratio = '4 / 3',
  sizes = '(min-width: 960px) 540px, 100vw',
  focus = 'center',
  highlight,
} = Astro.props;
---

<figure class="art-frame" style={`aspect-ratio: ${ratio}`}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes={sizes}
        class="art-frame__img"
        style={`object-position: ${focus}`}
      />
    ) : (
      <div class="art-frame__fallback">
        <HexCluster highlight={highlight} />
      </div>
    )
  }
</figure>

<style>
  .art-frame {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
    background:
      radial-gradient(circle at 50% 45%, rgb(139 92 246 / 0.22), transparent 60%),
      var(--color-surface);
  }

  .art-frame__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .art-frame__fallback {
    position: absolute;
    inset: 10%;
  }

  /* SVG keeps its square aspect and centres itself inside the box (preserveAspectRatio "meet"). */
  .art-frame__fallback :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
