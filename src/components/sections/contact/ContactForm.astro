---
/**
 * Enquiry form, delivered by Web3Forms to the company inbox.
 * Without a PUBLIC_WEB3FORMS_KEY (see .env.example) it shows a plain "email us" card instead.
 */
import Button from '@components/ui/Button.astro';
import FormField from './FormField.astro';
import { site } from '@data/site';
import { serviceOptions } from '@data/contact';
import { withBase } from '@lib/url';

const enabled = site.web3formsKey.length > 0;
const thanksUrl = new URL(withBase('thanks/'), Astro.site).href;
---

<div class="contact-card">
  {
    enabled ? (
      <form
        class="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        data-contact-form
        data-email={site.email}
      >
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value="New enquiry from the HexaFox website" />
        <input type="hidden" name="from_name" value="HexaFox website" />
        <input type="hidden" name="redirect" value={thanksUrl} />
        <input type="checkbox" name="botcheck" class="contact-form__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="contact-form__row">
          <FormField name="name" label="Name" required autocomplete="name" placeholder="Your name" />
          <FormField name="email" label="Email" type="email" required autocomplete="email" placeholder="you@company.com" />
        </div>
        <FormField name="company" label="Company" autocomplete="organization" placeholder="Company or project name" />
        <FormField name="service" label="What do you need?" type="select" options={serviceOptions} required />
        <FormField name="message" label="Tell us about it" type="textarea" required placeholder="A few lines about the problem or idea" />

        <div class="contact-form__footer">
          <Button type="submit">Send message</Button>
          <p class="contact-form__status" data-form-status role="status" aria-live="polite" />
        </div>
      </form>
    ) : (
      <div class="contact-fallback">
        <h3>Write to us directly</h3>
        <p>Send a few lines about your project and we’ll reply within {site.responseTime}.</p>
        <Button href={`mailto:${site.email}?subject=Project enquiry`}>Email us</Button>
      </div>
    )
  }
</div>

<script>
  import '../../../scripts/contact-form';
</script>

<style>
  .contact-card {
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.25rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .contact-form {
    display: grid;
    gap: var(--space-5);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .contact-form__trap {
    position: absolute;
    left: -9999px;
  }

  .contact-form__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .contact-form__status {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .contact-form[data-state='success'] .contact-form__status {
    color: var(--color-success);
  }

  .contact-form[data-state='error'] .contact-form__status {
    color: var(--color-danger);
  }

  .contact-fallback {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .contact-fallback h3 {
    font-size: var(--text-xl);
  }

  .contact-fallback p {
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
