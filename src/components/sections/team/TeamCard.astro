---
import HexPhoto from '@components/ui/HexPhoto.astro';
import type { TeamMember } from '@data/team';

interface Props {
  member: TeamMember;
  index: number;
}

const { member, index } = Astro.props;
---

<li class="member" data-reveal style={`--reveal-delay: ${(index % 3) * 90}ms`}>
  <HexPhoto src={member.photo} alt={`Portrait of ${member.name}`} width={168} class="member__photo" />
  <h3>{member.name}</h3>
  <p class="member__role">Co-founder · {member.role}</p>
  <p class="member__bio">{member.bio}</p>
</li>

<style>
  .member {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .member > :global(.member__photo) {
    margin-bottom: var(--space-3);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .member:hover > :global(.member__photo) {
    transform: translateY(-4px) rotate(-2deg);
  }

  h3 {
    font-size: 1.15rem;
  }

  .member__role {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-violet-soft);
  }

  .member__bio {
    max-width: 18rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 520px) {
    .member {
      grid-template-columns: 96px 1fr;
      grid-template-rows: auto auto 1fr;
      column-gap: var(--space-4);
      row-gap: var(--space-1);
      justify-items: start;
      text-align: left;
    }

    .member > :global(.member__photo) {
      --hex-photo-size: 96px;
      grid-row: 1 / span 3;
      margin-bottom: 0;
    }
  }
</style>
