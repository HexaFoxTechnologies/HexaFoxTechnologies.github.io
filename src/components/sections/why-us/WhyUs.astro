---
/**
 * Why HexaFox: the principles that stay the same on every project, each linking to the section that shows it.
 * Heading on top like every section, then a 2×2 grid split by hairlines, with no cards, so it reads as a calm
 * beat after the boxed sections above.
 */
import SectionHeader from '@components/ui/SectionHeader.astro';
import ReasonRow from './ReasonRow.astro';
import { reasons, reasonsIntro, reasonsTitle } from '@data/reasons';
---

<section id="why-us" class="section" aria-labelledby="why-title">
  <div class="container">
    <SectionHeader id="why-title" eyebrow="Why HexaFox" title={reasonsTitle} intro={reasonsIntro} />
    <ul class="why">
      {reasons.map((reason, i) => <ReasonRow reason={reason} index={i} />)}
    </ul>
  </div>
</section>

<style>
  .why {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid var(--color-line);
  }

  .why > :global(li) {
    border-top: 1px solid var(--color-line);
  }

  .why > :global(li:nth-child(odd)) {
    padding-right: var(--space-6);
  }

  .why > :global(li:nth-child(even)) {
    padding-left: var(--space-6);
    border-left: 1px solid var(--color-line);
  }

  @media (max-width: 760px) {
    .why {
      grid-template-columns: 1fr;
    }

    .why > :global(li:nth-child(n)) {
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>
