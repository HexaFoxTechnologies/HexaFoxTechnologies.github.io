---
/**
 * Why HexaFox: the principles that stay the same on every project, each linking to the section that shows it.
 * Editorial layout: large outlined numbers, the right column set lower so the four read as a zigzag.
 */
import SectionHeader from '@components/ui/SectionHeader.astro';
import { reasons, reasonsIntro, reasonsTitle } from '@data/reasons';
import { withBase } from '@lib/url';
---

<section id="why-us" class="section" aria-labelledby="why-title">
  <div class="container">
    <SectionHeader id="why-title" eyebrow="Why HexaFox" title={reasonsTitle} intro={reasonsIntro} />
    <ol class="nums">
      {
        reasons.map((reason, i) => (
          <li class="item" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="item__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{reason.title}</h3>
            <p>{reason.text}</p>
            <a href={withBase(reason.href)}>{reason.proof} →</a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .nums {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) clamp(2rem, 6vw, 6rem);
    padding-bottom: 5rem;
  }

  /* The right column starts lower, so the four read as a zigzag rather than a table. (`translate`, not
     `transform`, so it doesn't fight the scroll reveal.) */
  .item:nth-child(even) {
    translate: 0 5rem;
  }

  .item {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line-strong);
  }

  .item__num {
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 4vw, 7rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(167 139 250 / 0.7);
    transition: color var(--dur-slow) var(--ease-out);
  }

  .item:hover .item__num,
  .item:focus-within .item__num {
    color: rgb(139 92 246 / 0.35);
  }

  h3 {
    font-size: var(--text-xl);
  }

  p {
    max-width: 30rem;
    color: var(--color-text-muted);
  }

  a {
    justify-self: start;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-lavender);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .item__num {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .nums {
      grid-template-columns: 1fr;
      padding-bottom: 0;
    }

    .item:nth-child(even) {
      translate: none;
    }
  }
</style>
