---
import SectionHeader from '@components/ui/SectionHeader.astro';
import ReasonCard from './ReasonCard.astro';
import { reasons } from '@data/reasons';
---

<section id="why-us" class="section" aria-labelledby="why-title">
  <div class="container">
    <SectionHeader id="why-title" eyebrow="Why HexaFox" title="A small team that covers the whole job" />
    <ul class="reasons">
      {reasons.map((reason, i) => <ReasonCard reason={reason} index={i} />)}
    </ul>
  </div>
</section>

<style>
  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-4);
  }
</style>
