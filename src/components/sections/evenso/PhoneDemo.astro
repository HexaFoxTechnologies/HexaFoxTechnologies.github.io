---
/**
 * The phone on /evenso/: a device frame around the real Evenso app (its demo build in
 * public/evenso/demo/, made by tools/build-evenso-demo.sh), drawn at phone size and scaled to fit.
 * Evenso's own splash shows until the app has drawn. src/scripts/evenso/tour.ts moves the app between
 * screens as the page scrolls; "Try it yourself" hands it to the visitor.
 */
import { Image } from 'astro:assets';
import Button from '@components/ui/Button.astro';
import icon from '@assets/evenso/icon.png';
import { phone } from '@data/evenso';
import { withBase } from '@lib/url';

const demo = withBase('evenso/demo/');
---

<div class="phone" data-phone data-demo={demo} data-state="idle" data-mode="tour">
  <div class="phone__device">
    <div class="phone__screen" data-phone-screen inert>
      <div class="phone__canvas">
        <div class="phone__status" aria-hidden="true">
          <span>9:41</span>
          <svg viewBox="0 0 54 12" width="54" height="12">
            <path d="M1 9h2v2H1zM5 7h2v4H5zM9 4h2v7H9zM13 1h2v10h-2z" fill="currentColor"></path>
            <path d="M22 4.5a7 7 0 0 1 9 0M24 7a4 4 0 0 1 5 0" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"></path>
            <circle cx="26.5" cy="9.6" r="1.2" fill="currentColor"></circle>
            <rect x="35.5" y="1.5" width="15" height="9" rx="2.5" stroke="currentColor" fill="none" opacity="0.5"></rect>
            <rect x="37" y="3" width="12" height="6" rx="1.4" fill="currentColor"></rect>
            <path d="M52 4.5v3" stroke="currentColor" stroke-width="1.4" opacity="0.5" stroke-linecap="round"></path>
          </svg>
        </div>
        <iframe title={phone.frameLabel} allow="clipboard-write; web-share"></iframe>
      </div>
      <div class="phone__splash">
        <Image src={icon} alt="" width={88} height={88} loading="eager" />
        <p class="phone__splash-text phone__splash-text--loading">{phone.loading}</p>
        <p class="phone__splash-text phone__splash-text--no-js">{phone.noScript}</p>
        <div class="phone__splash-text phone__splash-text--failed">
          <p>{phone.failed}</p>
          <a href={demo}>{phone.openFull}</a>
        </div>
        <button class="phone__load" type="button" data-phone-load>{phone.loadButton}</button>
      </div>
    </div>
  </div>

  <div class="phone__controls">
    <p class="phone__note phone__note--tour">{phone.tourNote}</p>
    <p class="phone__note phone__note--hands-on">{phone.tryNote}</p>
    <div class="phone__buttons">
      <span class="phone__try" data-phone-try><Button href={demo} variant="soft" size="sm">{phone.tryButton}</Button></span>
      <span class="phone__back"><Button variant="soft" size="sm" class="js-phone-back">{phone.backButton}</Button></span>
      <span class="phone__reset"><Button variant="ghost" size="sm" class="js-phone-reset">{phone.resetButton}</Button></span>
    </div>
  </div>
</div>

<style>
  /* The app is drawn at 375 × 812 (a common phone size) and scaled by --s to fit the page. */
  .phone {
    --s: 0.5;
    --bezel: 11px;
    --screen-w: calc(375px * var(--s));
    --screen-h: calc(812px * var(--s));
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }

  .phone__device {
    position: relative;
    padding: var(--bezel);
    border-radius: calc(52px * var(--s) + var(--bezel));
    background: linear-gradient(160deg, #2a2240, #120e20 40%, #0c0918);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08) inset,
      0 30px 80px -30px rgb(253 112 83 / 0.45),
      0 20px 60px -20px rgb(0 0 0 / 0.8);
  }

  /* Evenso's glow: purple at the top, sunset at the bottom, like its logo. */
  .phone__device::before {
    content: '';
    position: absolute;
    inset: 8% -18%;
    z-index: -1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 25%, rgb(186 99 251 / 0.35), transparent 60%),
      radial-gradient(circle at 50% 80%, rgb(253 146 73 / 0.3), transparent 60%);
    filter: blur(30px);
  }

  .phone__screen {
    position: relative;
    width: var(--screen-w);
    height: var(--screen-h);
    overflow: hidden;
    border-radius: calc(44px * var(--s));
    background: #f6f5f1;
  }

  .phone__canvas {
    display: flex;
    flex-direction: column;
    width: 375px;
    height: 812px;
    transform: scale(var(--s));
    transform-origin: 0 0;
  }

  .phone__status {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    padding: 6px 26px 0 34px;
    color: #16181d;
    font: 600 15px/1 system-ui, sans-serif;
  }

  iframe {
    flex: 1;
    width: 100%;
    border: 0;
    background: #f6f5f1;
  }

  /* During the tour the page scrolls, not the app; "Try it yourself" lets the app take taps. */
  [data-mode='tour'] iframe {
    pointer-events: none;
  }

  .phone__splash {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    background: #0b0622;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  .phone__splash img {
    width: 88px;
    height: 88px;
    border-radius: 22px;
  }

  [data-state='ready'] .phone__splash {
    visibility: hidden;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .phone__splash {
      transition:
        opacity 400ms ease,
        visibility 0s linear 400ms;
    }
  }

  /* One line at a time under the logo, depending on how far loading got. */
  .phone__splash-text,
  .phone__load {
    display: none;
  }

  :global(.js) [data-state='loading'] .phone__splash-text--loading,
  :global(.no-js) .phone__splash-text--no-js,
  [data-ask][data-state='idle'] .phone__load {
    display: block;
  }

  [data-state='failed'] .phone__splash-text--failed {
    display: grid;
    gap: var(--space-2);
  }

  .phone__splash-text--failed a {
    color: var(--color-lavender);
  }

  .phone__load {
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.06);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }

  .phone__controls {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    max-width: calc(var(--screen-w) + 4rem);
    text-align: center;
  }

  .phone__note {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .phone__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  [data-mode='tour'] .phone__note--hands-on,
  [data-mode='hands-on'] .phone__note--tour,
  [data-mode='tour'] .phone__back,
  [data-mode='tour'] .phone__reset,
  [data-mode='hands-on'] .phone__try {
    display: none;
  }

  /* Small screens: the phone stays compact, and "Try it yourself" opens the app full screen. */
  @media (max-width: 899px) {
    .phone__note {
      display: none;
    }
  }

  @media (max-width: 899px) and (max-height: 700px) {
    .phone {
      --s: 0.42;
    }
  }

  @media (min-width: 600px) and (max-width: 899px) and (min-height: 900px) {
    .phone {
      --s: 0.64;
    }
  }

  /*
   * Side by side with the text: as big as the window's height allows, with the buttons ending above the
   * site's chat launcher in the bottom corner (about 90px). The phone's block is 812px × --s plus about
   * 210px of header, frame and buttons.
   */
  @media (min-width: 900px) {
    .phone {
      --s: 0.42;
    }
  }

  @media (min-width: 900px) and (min-height: 700px) {
    .phone {
      --s: 0.5;
    }
  }

  @media (min-width: 900px) and (min-height: 760px) {
    .phone {
      --s: 0.56;
    }
  }

  @media (min-width: 900px) and (min-height: 820px) {
    .phone {
      --s: 0.64;
    }
  }

  @media (min-width: 900px) and (min-height: 880px) {
    .phone {
      --s: 0.7;
    }
  }

  @media (min-width: 900px) and (min-height: 960px) {
    .phone {
      --s: 0.78;
    }
  }

  @media (min-width: 900px) and (min-height: 1060px) {
    .phone {
      --s: 0.88;
    }
  }
</style>
