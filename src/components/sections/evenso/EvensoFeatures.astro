---
/** What else Evenso does well: a grid of short claims, each one true in the app today. */
import SectionHeader from '@components/ui/SectionHeader.astro';
import InfoCard from '@components/sections/foxdesk/InfoCard.astro';
import { features } from '@data/evenso';
---

<section id="features" class="section section--tinted" aria-labelledby="features-title">
  <div class="container">
    <SectionHeader id="features-title" eyebrow={features.eyebrow} title={features.title} />
    <ul class="features">
      {features.items.map((feature, i) => <InfoCard item={feature} index={i} />)}
    </ul>
  </div>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-4);
  }
</style>
