---
/**
 * The top of /evenso/: the intro and the scroll tour beside one phone running the real app. Side by
 * side, the phone sticks in the right column; on small screens it sticks under the header and the
 * steps scroll up underneath it. Each block's [data-screen] is the route the phone shows while it's read.
 */
import HexGridBackground from '@components/ui/HexGridBackground.astro';
import TourIntro from './TourIntro.astro';
import TourStep from './TourStep.astro';
import PhoneDemo from './PhoneDemo.astro';
import { tour } from '@data/evenso';
---

<section class="tour" aria-labelledby="evenso-title">
  <HexGridBackground />
  <div class="container tour__grid">
    <TourIntro />
    <div class="tour__body">
      <div class="tour__phone">
        <div class="tour__sticky">
          <PhoneDemo />
        </div>
      </div>
      <div class="tour__steps">
        <h2 id="how-it-works" class="sr-only">{tour.label}</h2>
        <ol>
          {tour.steps.map((step, index) => <TourStep step={step} index={index} />)}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../../scripts/evenso/tour';
</script>

<style>
  .tour {
    position: relative;
    padding-bottom: var(--section-space);
  }

  .tour__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(2rem, 1rem + 5vw, 6rem);
  }

  /* Side by side, the phone and the steps are the grid's own items. */
  .tour__body {
    display: contents;
  }

  .tour__phone {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .tour__sticky {
    position: sticky;
    top: calc(var(--header-h) + var(--space-4));
    padding-top: var(--space-4);
  }

  .tour__steps {
    grid-column: 1;
    grid-row: 2;
  }

  #how-it-works {
    scroll-margin-top: var(--header-h);
  }

  /*
   * Stacked: the phone sticks under the header on a band of page colour, and the steps scroll up
   * underneath it, so each one is read just below the phone.
   */
  @media (max-width: 899px) {
    .tour__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .tour__body {
      display: block;
    }

    .tour__phone {
      position: sticky;
      top: var(--header-h);
      z-index: 1;
      padding-block: var(--space-3);
      background: var(--color-bg);
      box-shadow: 0 0 0 100vmax var(--color-bg);
      clip-path: inset(0 -100vmax);
    }

    .tour__sticky {
      position: static;
      padding-top: 0;
    }
  }

  /* Too short to keep the phone in view and still read: let it scroll away. */
  @media (max-width: 899px) and (max-height: 560px) {
    .tour__phone {
      position: static;
    }
  }
</style>
