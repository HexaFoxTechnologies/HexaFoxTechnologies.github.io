---
/**
 * The picture for one "How it works" step, drawn in SVG with the site's colours: your site and a
 * PDF (read), a page with the script tag and the chat button (embed), a chat answer with its
 * source (answer). Decorative: the step's heading and text say the same thing.
 */
interface Props {
  kind: 'read' | 'embed' | 'answer';
}

const { kind } = Astro.props;
---

<svg class="step-art" viewBox="0 0 240 160" aria-hidden="true" focusable="false">
  {
    kind === 'read' && (
      <g>
        <rect class="frame" x="16" y="14" width="168" height="124" rx="10" />
        <path class="rule" d="M16 32h168" />
        <circle class="dot" cx="28" cy="23" r="3" />
        <circle class="dot" cx="38" cy="23" r="3" />
        <circle class="dot" cx="48" cy="23" r="3" />
        <rect class="accent" x="28" y="44" width="84" height="8" rx="4" />
        <rect class="line" x="28" y="60" width="140" height="5" rx="2.5" />
        <rect class="line" x="28" y="70" width="124" height="5" rx="2.5" />
        <rect class="line" x="28" y="80" width="132" height="5" rx="2.5" />
        <rect class="block" x="28" y="94" width="56" height="32" rx="5" />
        <path class="rule" d="M34 120l12-12 8 7 6-5 14 10" />
        <rect class="line" x="92" y="98" width="52" height="5" rx="2.5" />
        <rect class="line" x="92" y="108" width="40" height="5" rx="2.5" />
        <g transform="translate(162 68)">
          <path class="doc" d="M0 6a6 6 0 0 1 6-6h36l16 16v54a6 6 0 0 1-6 6H6a6 6 0 0 1-6-6z" />
          <path class="fold" d="M42 0v16h16" />
          <text class="tag" x="10" y="38">PDF</text>
          <rect class="line" x="10" y="48" width="38" height="4" rx="2" />
          <rect class="line" x="10" y="57" width="28" height="4" rx="2" />
        </g>
      </g>
    )
  }
  {
    kind === 'embed' && (
      <g>
        <rect class="frame" x="16" y="14" width="208" height="132" rx="10" />
        <rect class="code" x="28" y="28" width="184" height="22" rx="6" />
        <text class="mono" x="38" y="43">{'<script src="…/widget.js">'}</text>
        <rect class="line" x="28" y="66" width="120" height="5" rx="2.5" />
        <rect class="line" x="28" y="76" width="150" height="5" rx="2.5" />
        <rect class="line" x="28" y="86" width="100" height="5" rx="2.5" />
        <rect class="line" x="28" y="96" width="132" height="5" rx="2.5" />
        <path class="dash" d="M168 54c18 14 26 26 24 42" />
        <polygon class="launcher" points="192,100 207.6,109 207.6,127 192,136 176.4,127 176.4,109" />
        <path class="bubble" d="M184 112h16a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-9l-5 4v-4h-2a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3z" />
      </g>
    )
  }
  {
    kind === 'answer' && (
      <g>
        <rect class="window" x="16" y="10" width="208" height="140" rx="12" />
        <path class="rule" d="M16 36h208" />
        <polygon class="logo" points="32,14 40.7,19 40.7,29 32,34 23.3,29 23.3,19" />
        <rect class="accent" x="48" y="20" width="56" height="7" rx="3.5" />
        <rect class="visitor" x="120" y="44" width="92" height="22" rx="11" />
        <text class="on-violet" x="131" y="59">Opening hours?</text>
        <rect class="block" x="28" y="74" width="156" height="40" rx="10" />
        <rect class="line" x="38" y="84" width="124" height="5" rx="2.5" />
        <rect class="line" x="38" y="96" width="92" height="5" rx="2.5" />
        <circle class="cite" cx="142" cy="98.5" r="6" />
        <text class="cite-n" x="142" y="101.5">1</text>
        <rect class="chip" x="28" y="122" width="96" height="20" rx="10" />
        <circle class="cite" cx="40" cy="132" r="6" />
        <text class="cite-n" x="40" y="135">1</text>
        <text class="source" x="52" y="136">Contact page ↗</text>
      </g>
    )
  }
</svg>

<style>
  .step-art {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }

  .frame {
    fill: var(--color-bg-deep);
    stroke: var(--color-line-strong);
  }

  .window {
    fill: var(--color-surface);
    stroke: var(--color-line-strong);
  }

  .rule,
  .fold {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .dot {
    fill: var(--color-line-strong);
  }

  .accent {
    fill: var(--color-violet-soft);
  }

  .line {
    fill: var(--color-line-strong);
  }

  .block {
    fill: var(--color-surface-raised);
  }

  .doc {
    fill: var(--color-surface);
    stroke: var(--color-violet);
    stroke-width: 1.5;
  }

  .tag {
    fill: var(--color-lavender);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .code {
    fill: var(--color-surface-raised);
    stroke: var(--color-line-strong);
  }

  .mono {
    fill: var(--color-lavender);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 10.5px;
  }

  .dash {
    fill: none;
    stroke: var(--color-lavender);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
    stroke-linecap: round;
  }

  .launcher,
  .logo,
  .cite {
    fill: var(--color-violet);
  }

  .bubble {
    fill: #fff;
  }

  .visitor {
    fill: var(--color-violet-strong);
  }

  .on-violet {
    fill: #fff;
    font-size: 10.5px;
  }

  .cite-n {
    fill: #fff;
    font-size: 8px;
    font-weight: 600;
    text-anchor: middle;
  }

  .chip {
    fill: none;
    stroke: var(--color-lavender);
    stroke-opacity: 0.6;
  }

  .source {
    fill: var(--color-lavender);
    font-size: 10px;
  }
</style>
