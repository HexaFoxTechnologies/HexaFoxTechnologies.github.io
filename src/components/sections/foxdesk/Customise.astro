---
/** "Make it yours": three example looks, then what a client can change, in four short lists. */
import SectionHeader from '@components/ui/SectionHeader.astro';
import ThemeMock from './ThemeMock.astro';
import { customise } from '@data/foxdesk';
---

<section id="customise" class="section" aria-labelledby="customise-title">
  <div class="container">
    <SectionHeader id="customise-title" eyebrow={customise.eyebrow} title={customise.title} intro={customise.intro} />
    <figure class="looks" role="img" aria-label={customise.looksLabel} data-reveal>
      {customise.looks.map((look) => <ThemeMock look={look} />)}
    </figure>
    <div class="groups">
      {
        customise.groups.map((group, i) => (
          <div class="group" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .looks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 0.5rem + 2.5vw, 2.5rem);
    margin: 0 0 var(--space-7);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-5) var(--space-6);
  }

  .group {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  h3 {
    font-size: 1.05rem;
  }

  ul {
    display: grid;
    gap: var(--space-2);
  }

  li {
    position: relative;
    padding-left: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  li::before {
    content: '';
    position: absolute;
    top: 0.6em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-violet-soft);
  }

  /* On phones the looks sit side by side in a row you swipe, instead of a tall stack. */
  @media (max-width: 760px) {
    .looks {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(78%, 300px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: var(--space-3);
      scrollbar-width: thin;
    }

    .looks > :global(*) {
      scroll-snap-align: start;
    }
  }
</style>
