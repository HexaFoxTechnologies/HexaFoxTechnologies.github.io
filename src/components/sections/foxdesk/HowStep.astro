---
import HexMarker from '@components/ui/HexMarker.astro';
import type { TitledText } from '@data/foxdesk';

interface Props {
  step: TitledText;
  index: number;
}

const { step, index } = Astro.props;
---

<li class="how-step" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
  <HexMarker label={String(index + 1)} />
  <h3>{step.title}</h3>
  <p>{step.text}</p>
</li>

<style>
  .how-step {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  h3 {
    margin-top: var(--space-2);
    font-size: 1.15rem;
  }

  p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
