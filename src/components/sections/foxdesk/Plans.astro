---
/** Managed (the main offer) and self-hosted. No prices: both go to "Talk to us". */
import SectionHeader from '@components/ui/SectionHeader.astro';
import PlanCard from './PlanCard.astro';
import { plans } from '@data/foxdesk';
---

<section id="plans" class="section section--tinted" aria-labelledby="plans-title">
  <div class="container">
    <SectionHeader id="plans-title" eyebrow={plans.eyebrow} title={plans.title} intro={plans.intro} />
    <ul class="plans">
      {plans.items.map((plan, i) => <PlanCard plan={plan} index={i} />)}
    </ul>
  </div>
</section>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: var(--space-5);
    align-items: start;
  }
</style>
