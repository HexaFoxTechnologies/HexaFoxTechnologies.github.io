---
/**
 * "You're looking at it": the chat on this site is FoxDesk. The button opens it through the
 * widget's window.FoxDesk.open(); it stays hidden until the widget has loaded (never in `npm run
 * dev`, where the chat is left out), and the text says where the chat button is either way.
 */
import Button from '@components/ui/Button.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import { demo } from '@data/foxdesk';
---

<section id="demo" class="section section--tinted" aria-labelledby="demo-title">
  <div class="container demo">
    <SectionHeader id="demo-title" eyebrow={demo.eyebrow} title={demo.title} intro={demo.intro}>
      <div data-foxdesk-open hidden>
        <Button>{demo.button}</Button>
      </div>
      <p class="demo__where">{demo.where}</p>
    </SectionHeader>

    <div class="demo__try" data-reveal style="--reveal-delay: 120ms">
      <h3>{demo.tryLabel}</h3>
      <ul>
        {demo.questions.map((question) => <li>{question}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  import '../../../scripts/foxdesk-open';
</script>

<style>
  .demo {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .demo > :global(.section-header) {
    margin-bottom: 0;
  }

  .demo__where {
    color: var(--color-text-muted);
  }

  .demo__try {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  h3 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  ul {
    display: grid;
    gap: var(--space-3);
  }

  /* Styled like the visitor's messages in the chat. */
  li {
    justify-self: end;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    border-bottom-right-radius: 4px;
    background: rgb(115 71 230 / 0.85);
    color: #fff;
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .demo {
      grid-template-columns: 1fr;
    }

    .demo__try {
      width: min(100%, 460px);
    }
  }
</style>
