---
/** How we work: five steps on one line; each says when, what happens, what you get and what you decide. */
import Button from '@components/ui/Button.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import ProcessStep from './ProcessStep.astro';
import { processCta, processIntro, processSteps, processTitle } from '@data/process';
import { withBase } from '@lib/url';
---

<section id="process" class="section section--tinted" aria-labelledby="process-title">
  <div class="container">
    <SectionHeader id="process-title" eyebrow="How we work" title={processTitle} intro={processIntro} />
    <ol class="steps">
      {processSteps.map((step, i) => <ProcessStep step={step} index={i} />)}
    </ol>
    <div class="cta" data-reveal>
      <Button href={withBase(processCta.href)}>{processCta.label}</Button>
    </div>
  </div>
</section>

<style>
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 25px;
    left: 22px;
    /* Ends at the last step's marker: one column width less its half-marker. */
    right: calc((100% - 4 * var(--space-4)) / 5 - 22px);
    height: 1px;
    background: linear-gradient(90deg, var(--color-violet), var(--color-line-strong));
  }

  .cta {
    margin-top: var(--space-6);
  }

  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .steps::before {
      top: 0;
      bottom: 0;
      left: 22px;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(var(--color-violet), var(--color-line-strong));
    }
  }
</style>
