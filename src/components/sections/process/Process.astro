---
import SectionHeader from '@components/ui/SectionHeader.astro';
import ProcessStep from './ProcessStep.astro';
import { processIntro, processSteps } from '@data/process';
---

<section id="process" class="section section--tinted" aria-labelledby="process-title">
  <div class="container">
    <SectionHeader id="process-title" eyebrow="How we work" title="From first call to long after launch" intro={processIntro} />
    <ol class="steps">
      {processSteps.map((step, i) => <ProcessStep step={step} index={i} />)}
    </ol>
  </div>
</section>

<style>
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-5);
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 25px;
    left: 22px;
    right: 22px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-violet), var(--color-line-strong));
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .steps::before {
      top: 0;
      bottom: 0;
      left: 22px;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(var(--color-violet), var(--color-line-strong));
    }
  }
</style>
