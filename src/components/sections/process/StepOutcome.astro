---
/** What the client gets from a step, and the decision they make before the next one. */
import type { ProcessStep } from '@data/process';

interface Props {
  step: ProcessStep;
}

const { step } = Astro.props;
---

<dl class="outcome">
  <div>
    <dt>You get</dt>
    <dd>{step.youGet}</dd>
  </div>
  {
    step.youDecide && (
      <div class="outcome__decide">
        <dt>You decide</dt>
        <dd>{step.youDecide}</dd>
      </div>
    )
  }
</dl>

<style>
  .outcome {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    font-size: var(--text-sm);
  }

  .outcome > div {
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-violet);
  }

  .outcome__decide {
    border-left-color: var(--color-amber) !important;
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-violet-soft);
  }

  .outcome__decide dt {
    color: var(--color-amber);
  }

  dd {
    margin: 0;
    color: var(--color-text);
  }
</style>
