---
import HexMarker from '@components/ui/HexMarker.astro';
import type { ProcessStep } from '@data/process';

interface Props {
  step: ProcessStep;
  index: number;
}

const { step, index } = Astro.props;
---

<li class="step" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
  <HexMarker label={String(index + 1)} />
  <div class="step__text">
    <h3>{step.title}</h3>
    <p>{step.text}</p>
  </div>
</li>

<style>
  .step {
    position: relative;
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  h3 {
    font-size: 1.15rem;
    margin-bottom: var(--space-2);
  }

  p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .step {
      grid-template-columns: 44px 1fr;
      gap: var(--space-5);
    }
  }
</style>
