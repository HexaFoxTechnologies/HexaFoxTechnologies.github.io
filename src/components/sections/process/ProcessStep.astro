---
/** One step of How we work: number and when on the line, then a card with what happens and its outcome. */
import HexMarker from '@components/ui/HexMarker.astro';
import StepOutcome from './StepOutcome.astro';
import type { ProcessStep } from '@data/process';

interface Props {
  step: ProcessStep;
  index: number;
}

const { step, index } = Astro.props;
// The proof-of-concept week is the step to notice.
const key = index === 1;
---

<li class:list={['step', { 'step--key': key }]} data-reveal style={`--reveal-delay: ${index * 90}ms`}>
  <div class="step__marker">
    <HexMarker label={String(index + 1)} />
    <span class="step__when">{step.when}</span>
  </div>
  <div class="step__body">
    <h3>{step.title}</h3>
    <p>{step.text}</p>
    <StepOutcome step={step} />
  </div>
</li>

<style>
  /* The card takes the rest of the row, so all five cards end on one line. */
  .step {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-4);
  }

  .step__marker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .step__when {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: var(--text-xs);
    color: var(--color-lavender);
    white-space: nowrap;
  }

  .step__body {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: rgb(23 19 42 / 0.7);
  }

  .step--key .step__body {
    border-color: rgb(167 139 250 / 0.6);
    background:
      radial-gradient(circle at 80% 0%, rgb(139 92 246 / 0.3), transparent 60%),
      rgb(23 19 42 / 0.85);
  }

  .step--key .step__when {
    border-color: var(--color-violet-soft);
    background: var(--color-violet-strong);
    color: #fff;
  }

  h3 {
    font-size: 1.1rem;
  }

  .step__body > p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 1000px) {
    .step {
      grid-template-columns: 44px 1fr;
      gap: var(--space-3) var(--space-4);
    }

    .step__marker {
      display: contents;
    }

    .step__marker :global(.hex-marker) {
      grid-row: 1 / span 2;
    }

    .step__when {
      justify-self: start;
    }
  }
</style>
