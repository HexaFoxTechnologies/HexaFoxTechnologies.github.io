---
/** The tools behind a service, as small pills. Renders nothing when the list is empty. */
interface Props {
  tech: string[];
}

const { tech } = Astro.props;
---

{
  tech.length > 0 && (
    <ul class="chips" aria-label="Tools we use">
      {tech.map((t) => (
        <li>{t}</li>
      ))}
    </ul>
  )
}

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: rgb(139 92 246 / 0.08);
    font-size: var(--text-xs);
    color: var(--color-lavender);
    white-space: nowrap;
  }
</style>
