---
import ArtFrame from '@components/ui/ArtFrame.astro';
import ServiceItem from './ServiceItem.astro';
import type { ServiceGroup } from '@data/services';
import { getGeneratedImage } from '@lib/images';

interface Props {
  group: ServiceGroup;
  index: number;
}

const { group, index } = Astro.props;
const titleId = `service-${group.id}`;
---

<article class="service-group" aria-labelledby={titleId} data-reveal style={`--reveal-delay: ${index * 120}ms`}>
  <ArtFrame
    image={getGeneratedImage(group.image)}
    alt={group.imageAlt}
    ratio="16 / 9"
    sizes="(min-width: 960px) 560px, 100vw"
    highlight={index === 0 ? [1, 3, 5] : [2, 4, 6]}
  />
  <div class="service-group__body">
    <header>
      <h3 id={titleId}>{group.title}</h3>
      <p>{group.intro}</p>
    </header>
    <ul>
      {group.items.map((item) => <ServiceItem item={item} />)}
    </ul>
  </div>
</article>

<style>
  .service-group {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-lg) + var(--space-4));
    background: rgb(23 19 42 / 0.5);
  }

  .service-group__body {
    display: grid;
    gap: var(--space-5);
    padding: 0 var(--space-3) var(--space-3);
  }

  header {
    display: grid;
    gap: var(--space-2);
  }

  h3 {
    font-size: var(--text-xl);
  }

  header p {
    color: var(--color-text-muted);
  }

  ul {
    display: grid;
    gap: var(--space-4);
  }
</style>
