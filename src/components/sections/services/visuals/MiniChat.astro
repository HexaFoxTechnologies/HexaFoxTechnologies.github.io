---
/** Tiny chat: a question, an answer and its source. Decorative. */
---

<div class="chat" aria-hidden="true">
  <p class="q">Do you deliver on Sundays?</p>
  <p class="a">Yes, from 9 am to 1 pm in Coimbatore. <span>Source · Delivery page</span></p>
</div>

<style>
  .chat {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-bg-deep);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  p {
    max-width: 85%;
    padding: 0.45rem 0.7rem;
    border-radius: 12px;
  }

  .q {
    justify-self: end;
    background: var(--color-violet-strong);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .a {
    background: var(--color-surface-raised);
    color: var(--color-text);
    border-bottom-left-radius: 4px;
  }

  span {
    display: block;
    margin-top: 0.3rem;
    color: var(--color-lavender);
    font-size: 0.7rem;
  }
</style>
