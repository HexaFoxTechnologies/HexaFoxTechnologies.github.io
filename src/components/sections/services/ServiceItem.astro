---
import HexMarker from '@components/ui/HexMarker.astro';
import type { ServiceItem } from '@data/services';
import { withBase } from '@lib/url';

interface Props {
  item: ServiceItem;
}

const { item } = Astro.props;
---

<li class="service-item">
  <HexMarker size="sm" />
  <div>
    <h4>{item.title}</h4>
    <p>{item.text}</p>
    {item.link && <a class="service-item__link" href={withBase(item.link.href)}>{item.link.label} →</a>}
  </div>
</li>

<style>
  .service-item {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .service-item > :global(.hex-marker) {
    margin-top: 3px;
  }

  h4 {
    font-size: 1rem;
    margin-bottom: var(--space-1);
  }

  p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .service-item__link {
    display: inline-block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-violet-soft);
  }

  .service-item__link:hover {
    color: var(--color-lavender);
  }
</style>
