---
/** Line icon for one service, drawn in currentColor. Decorative: the card text names the service. */
import { serviceIconPaths } from '@lib/serviceIcons';

interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
  {(serviceIconPaths[id] ?? []).map((d) => <path d={d} />)}
</svg>

<style>
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
