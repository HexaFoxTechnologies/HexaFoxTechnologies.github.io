---
/** "Our product" band on the home page: one card that leads to the FoxDesk page. */
import ChatMock from '@components/sections/foxdesk/ChatMock.astro';
import { productBand } from '@data/foxdesk';
import { withBase } from '@lib/url';
---

<section id="product" class="product" aria-labelledby="product-title">
  <div class="container">
    <article class="product__card" data-reveal>
      <div class="product__copy">
        <p class="eyebrow">{productBand.eyebrow}</p>
        <h2 id="product-title">{productBand.title}</h2>
        <p class="product__text">{productBand.text}</p>
        <a class="product__link" href={withBase(productBand.link.href)}>
          {productBand.link.label} <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="product__preview">
        <ChatMock size="compact" />
      </div>
    </article>
  </div>
</section>

<style>
  .product {
    padding-bottom: var(--section-space);
  }

  .product__card {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: center;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-lg) + var(--space-4));
    background:
      radial-gradient(ellipse at 85% 50%, rgb(139 92 246 / 0.16), transparent 70%),
      rgb(23 19 42 / 0.5);
  }

  .product__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  h2 {
    font-size: var(--text-2xl);
  }

  .product__text {
    max-width: 32rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .product__link {
    font-weight: 500;
    color: var(--color-violet-soft);
  }

  .product__link:hover {
    color: var(--color-lavender);
  }

  @media (max-width: 820px) {
    .product__card {
      grid-template-columns: 1fr;
    }
  }
</style>
