---
/** Evenso's card in the home page's product band: a picture of the real app, not the live one, to keep the home page light. */
import { Image } from 'astro:assets';
import overview from '@assets/evenso/overview.png';
import { productCard } from '@data/evenso';
import { withBase } from '@lib/url';
---

<article class="evenso-card" data-reveal>
  <div class="evenso-card__copy">
    <p class="eyebrow">{productCard.eyebrow}</p>
    <h3>{productCard.title}</h3>
    <p class="evenso-card__text">{productCard.text}</p>
    <a class="evenso-card__link" href={withBase(productCard.link.href)}>
      {productCard.link.label} <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class="evenso-card__preview">
    <Image src={overview} alt={productCard.imageAlt} widths={[220, 440]} sizes="220px" />
  </div>
</article>

<style>
  .evenso-card {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: center;
    overflow: hidden;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem) clamp(1.5rem, 1rem + 2.5vw, 3rem) 0;
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-lg) + var(--space-4));
    background:
      radial-gradient(ellipse at 80% 90%, rgb(253 146 73 / 0.18), transparent 60%),
      radial-gradient(ellipse at 80% 20%, rgb(186 99 251 / 0.14), transparent 60%),
      rgb(23 19 42 / 0.5);
  }

  .evenso-card__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-bottom: clamp(1.5rem, 1rem + 2.5vw, 3rem);
  }

  /* Evenso's own accent: the sunset half of its logo. */
  .eyebrow {
    color: #fd9249;
  }

  .eyebrow::before {
    background: #fd7053;
  }

  h3 {
    font-size: var(--text-2xl);
  }

  .evenso-card__text {
    max-width: 32rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .evenso-card__link {
    font-weight: 500;
    color: #fd9249;
  }

  .evenso-card__link:hover {
    color: #fec58f;
  }

  /* The top of the phone, rising out of the card's bottom edge. */
  .evenso-card__preview {
    align-self: end;
    justify-self: center;
    width: 220px;
    height: 300px;
    overflow: hidden;
    padding: 8px 8px 0;
    border-radius: 34px 34px 0 0;
    background: linear-gradient(160deg, #2a2240, #120e20 40%, #0c0918);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08) inset;
  }

  .evenso-card__preview img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 26px 26px 0 0;
  }

  @media (max-width: 820px) {
    .evenso-card {
      grid-template-columns: 1fr;
    }

    .evenso-card__copy {
      padding-bottom: 0;
    }
  }
</style>
