---
/**
 * Conversation log. Messages are added by src/scripts/ask/messages.ts, so their styles are
 * global (prefixed .ask-) rather than scoped to this component.
 */
import { ask } from '@data/ask';
---

<div class="ask-log" role="log" aria-live="polite" aria-relevant="additions" tabindex="-1" data-ask-log>
  <div class="ask-msg ask-msg--assistant">{ask.greeting}</div>
  <slot />
</div>

<style is:global>
  .ask-log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: var(--color-line-strong) transparent;
  }

  .ask-msg {
    max-width: 88%;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .ask-msg--assistant {
    align-self: flex-start;
    border: 1px solid var(--color-line);
    border-bottom-left-radius: 4px;
    background: var(--color-bg);
  }

  .ask-msg--user {
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    background: var(--color-violet-strong);
    color: #fff;
    white-space: pre-wrap;
  }

  .ask-msg--error {
    border-color: rgb(252 165 165 / 0.35);
    color: var(--color-danger);
  }

  .ask-msg__body {
    display: grid;
    gap: var(--space-2);
  }

  .ask-msg__body ul {
    display: grid;
    gap: var(--space-1);
  }

  .ask-msg__body li {
    position: relative;
    padding-left: 1.1rem;
  }

  .ask-msg__body li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.6em;
    width: 7px;
    height: 8px;
    clip-path: var(--hex);
    background: var(--color-violet-soft);
  }

  .ask-msg__body strong {
    color: var(--color-lavender);
    font-weight: 600;
  }

  .ask-cite {
    display: inline-grid;
    place-items: center;
    width: 15px;
    height: 17px;
    margin-left: 2px;
    clip-path: var(--hex);
    background: rgb(139 92 246 / 0.35);
    color: var(--color-lavender);
    font-size: 0.6rem;
    font-weight: 600;
    line-height: 1;
    vertical-align: 0.15em;
  }

  .ask-sources {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .ask-source {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.2rem 0.65rem 0.2rem 0.35rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .ask-source:hover {
    border-color: var(--color-violet-soft);
    color: var(--color-text);
  }

  .ask-source .ask-cite {
    margin: 0;
    vertical-align: middle;
  }

  .ask-typing {
    display: inline-flex;
    gap: 5px;
    padding: 0.35rem 0;
  }

  .ask-typing span:not(.sr-only) {
    width: 8px;
    height: 9px;
    clip-path: var(--hex);
    background: var(--color-violet-soft);
    animation: ask-typing 1.1s ease-in-out infinite;
  }

  .ask-typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .ask-typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes ask-typing {
    0%,
    80%,
    100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask-typing span:not(.sr-only) {
      animation: none;
      opacity: 0.7;
    }
  }
</style>
