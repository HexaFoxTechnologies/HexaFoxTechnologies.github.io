---
/** The fox mark inside a hexagon, used on the launcher and in the panel header. */
import { Image } from 'astro:assets';
import mark from '@assets/brand/logo-mark.png';

interface Props {
  size?: 'sm' | 'md';
}

const { size = 'md' } = Astro.props;
const px = size === 'md' ? 30 : 22;
---

<span class:list={['ask-mark', `ask-mark--${size}`]} aria-hidden="true">
  <Image src={mark} alt="" width={px} densities={[1, 2]} loading="lazy" />
</span>

<style>
  .ask-mark {
    display: grid;
    place-items: center;
    flex: none;
    clip-path: var(--hex);
    background: linear-gradient(150deg, var(--color-violet), var(--color-violet-strong));
  }

  .ask-mark::before {
    content: '';
    grid-area: 1 / 1;
    width: calc(100% - 4px);
    height: calc(100% - 4px);
    clip-path: var(--hex);
    background: var(--color-bg-deep);
  }

  .ask-mark img {
    grid-area: 1 / 1;
    position: relative;
  }

  .ask-mark--md {
    width: 52px;
    height: 58px;
  }

  .ask-mark--sm {
    width: 36px;
    height: 40px;
  }
</style>
