# Web3Forms access key (public by design — it only lets the form send to your inbox).
# Get one at https://web3forms.com using hexafoxtech@gmail.com, then copy this file to .env
PUBLIC_WEB3FORMS_KEY=

# Ask HexaFox chat widget: the deployed Worker URL (see workers/ask-hexafox). Leave empty to hide the widget.
PUBLIC_ASK_API_URL=
# Optional Cloudflare Turnstile site key for the chat (public). Leave empty if the Worker has no TURNSTILE_SECRET_KEY.
PUBLIC_TURNSTILE_SITE_KEY=
