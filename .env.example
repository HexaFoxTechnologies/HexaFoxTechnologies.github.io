# Web3Forms access key (public by design — it only lets the form send to your inbox).
# Get one at https://web3forms.com using hexafoxtech@gmail.com, then copy this file to .env
PUBLIC_WEB3FORMS_KEY=

# Optional: the chat widget comes from FoxDesk (https://foxdesk-hexafox.hexafox.workers.dev/widget.js),
# which only answers on the live site, so `npm run dev` leaves it out. To try it locally, run
# `npm run fd -- dev hexafox` in the foxdesk repo and uncomment this.
# PUBLIC_FOXDESK_WIDGET_URL=http://localhost:8787/widget.js
